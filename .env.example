DATABASE_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# AI Provider Credentials (Server-only, do not prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# AI Provider Configuration Defaults
AI_PROVIDER=gemini # "gemini" or "openrouter"
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_MODEL=google/gemini-3.6-flash

# Latency Bounding & Resiliency configuration (timeouts in milliseconds)
AI_GEMINI_TIMEOUT_MS=8000
AI_OPENROUTER_TIMEOUT_MS=10000
AI_TOTAL_TIMEOUT_MS=15000

# Razorpay Payment & Subscription Credentials (Server-only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_URL=https://ca-prep-pro.vercel.app/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Predefined Razorpay Plan IDs (Live or Test mode)
RAZORPAY_PLAN_PLUS_ID=
RAZORPAY_PLAN_PRO_ID=

# Explicit Mock Billing (Development-only, disabled by default and rejected in production)
ENABLE_MOCK_BILLING=false

# Administration & Bootstrap Security (Server-only)
BOOTSTRAP_ADMIN_EMAIL=arnavgupta112@gmail.com